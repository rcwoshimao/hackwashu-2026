{
  "name": "ground-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "ops": "bun run ops.ts",
    "build:web": "bun run --cwd apps/web build",
    "build:extension": "bun run --cwd apps/extension build",
    "dev:api": "bun --watch run apps/api/src/main.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test apps packages action ops",
    "copy:lint": "bun run packages/copy/src/lint.ts",
    "golden": "bun test packages/claims/test/golden.test.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run copy:lint && bun run golden"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.2.22",
    "@types/chrome": "0.3.0",
    "@types/node": "22.18.6",
    "fast-check": "3.23.2",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@google/genai": "2.24.0",
    "@octokit/rest": "22.0.1",
    "@ground-control/ai": "workspace:*",
    "@ground-control/plan": "workspace:*",
    "@ground-control/publisher": "workspace:*",
    "@ground-control/scanner": "workspace:*",
    "@ground-control/sources": "workspace:*",
    "@ground-control/store": "workspace:*",
    "zod": "4.6.5"
  }
}
