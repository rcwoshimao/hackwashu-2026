# Public HTTPS origin of the Ground Control server.
PUBLIC_URL=
# Local Docker Desktop host port (default 8787); use another port if it is occupied.
GROUND_CONTROL_PORT=8787
# Gemini API key for public Sky AI scans and default connected-repo extraction.
GEMINI_API_KEY=
# Optional Claude extraction for connected sources and local seed/scan commands.
# Set EXTRACTION_MODEL=claude with this key; the public Sky remains on Gemini/static.
EXTRACTION_MODEL=
ANTHROPIC_API_KEY=
# Photon Spectrum project identifier for managed cloud iMessage.
SPECTRUM_PROJECT_ID=
# Photon Spectrum project secret. Provision an iMessage line in this project.
SPECTRUM_PROJECT_SECRET=
# GitHub token allowed to write connected repo contents, pull requests, and commit statuses.
GITHUB_WRITE_TOKEN=
# GitHub token used for read-only public scanning.
GITHUB_SCAN_TOKEN=
# GitHub OAuth app client identifier for dashboard sign-in.
GITHUB_CLIENT_ID=
# GitHub OAuth app client secret for dashboard sign-in.
GITHUB_CLIENT_SECRET=
# Session signing secret for seven-day sign-in sessions.
SESSION_SECRET=
# Confluence Cloud site hostname, such as yourteam.atlassian.net.
CONFLUENCE_SITE=
# Atlassian account email used for Confluence API access.
CONFLUENCE_EMAIL=
# Atlassian API token used for Confluence API access.
CONFLUENCE_API_TOKEN=
